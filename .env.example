# HushVoice engine (always-on clone + TTS server)
# No third-party API keys — models run on your machine / VPS.
#
# Local:
#   HUSHVOICE_ENGINE_URL=http://127.0.0.1:17493
# Production (Vercel → your engine host):
#   HUSHVOICE_ENGINE_URL=https://engine.yourdomain.com
HUSHVOICE_ENGINE_URL=http://127.0.0.1:17493

# TTS model family for zero-shot multilingual cloning
HUSHVOICE_TTS_ENGINE=chatterbox

# Required only when building the engine Docker image
# Point at a git repo with a compatible FastAPI voice stack
# (profiles / generate / audio API).
ENGINE_SOURCE_URL=
