# HushVoice engine (local clone + TTS server)
# No third-party voice API keys — models run on this computer.
HUSHVOICE_ENGINE_URL=http://127.0.0.1:17493

# TTS model family for zero-shot multilingual cloning
HUSHVOICE_TTS_ENGINE=chatterbox

# Shared secret: Next.js → engine. Set the SAME value as ENGINE_API_KEY in docker-compose.
# Leave empty for open local engine (not recommended once public).
HUSHVOICE_ENGINE_API_KEY=
ENGINE_API_KEY=

# Billing: metered (default) | open (skip caps — local power use only)
HUSHVOICE_BILLING_MODE=metered

# Session signing (change in production)
HUSHVOICE_SESSION_SECRET=change-me-in-production

# SQLite via libsql (default: file:./data/hushvoice.db)
# For Vercel use a remote Turso URL:
# HUSHVOICE_DATABASE_URL=libsql://your-db.turso.io
# HUSHVOICE_DATABASE_AUTH_TOKEN=

# Free / Pro caps (optional overrides)
# HUSHVOICE_FREE_SPEAKS_PER_DAY=5
# HUSHVOICE_FREE_MAX_CLONES=1
# HUSHVOICE_FREE_MAX_CHARS=300
# HUSHVOICE_PRO_MONTHLY_CREDITS=300
# HUSHVOICE_CREDIT_PACK_CREDITS=400

# Stripe (required for checkout)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Optional Price IDs (otherwise Checkout uses price_data one-time amounts)
STRIPE_PRICE_CREDITS=
STRIPE_PRICE_PRO=

# Public site URL for Stripe redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000
