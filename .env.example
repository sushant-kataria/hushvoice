# Self-hosted Voicebox server (https://github.com/jamiepine/voicebox)
# No third-party API keys required — cloning & TTS run on your machine / VPS.
#
# Local:
#   VOICEBOX_URL=http://127.0.0.1:17493
# Production (Vercel):
#   VOICEBOX_URL=https://voicebox.yourdomain.com
VOICEBOX_URL=http://127.0.0.1:17493

# Engine used for zero-shot cloning (Chatterbox Multilingual = 23 languages)
VOICEBOX_ENGINE=chatterbox
